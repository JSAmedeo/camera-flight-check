# build outputs / packaging artifacts
node_modules/
dist/
build/
camera-host/bin/
camera-host/obj/

# generated at verify-time / logs
__verify.html
*.log
npm-debug.log*

# local machine-specific permission grants (shared allowlist is .claude/settings.json)
.claude/settings.local.json

# NOTE: camera-host/lib/ (digiCamControl DLLs + EDSDK + VC runtimes) and vendor/
