# build outputs / packaging artifacts
node_modules/
dist/
build/
camera-host/bin/
camera-host/obj/

# generated at verify-time / logs
__verify.html
screenshots/
*.log
npm-debug.log*

# per-run session logs land here when a dev machine's Settings > File
# Output Paths > Completion Logs happens to point at (or default into) the
# repo directory instead of C:\preflight-ops-check\Logs -- runtime output,
# not source
sessions/

# local machine-specific permission grants (shared allowlist is .claude/settings.json)
.claude/settings.local.json

# NOTE: camera-host/lib/ (digiCamControl DLLs + EDSDK + VC runtimes) and vendor/
# (React/Babel/Geist) are vendored ON PURPOSE — they aren't on any package
# registry and the build needs them. Do not ignore them.

# Full live location feed sample (2.3MB) -- contains sales figures, contract
